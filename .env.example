# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git. Never paste these values into chat, email or code.

# Anthropic API key. Personal key now; student key later (also change key_label in configs\base.yaml).
ANTHROPIC_API_KEY=

# Alpaca (free paper-trading account) - used only to download historical news.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# SEC EDGAR asks every automated download to identify itself: a name and contact email.
# Example: QuantAgents research yourname@example.com
SEC_USER_AGENT=
